---
import siteConfig from '../data/site-config';

const socialLinks = siteConfig.socialLinks ?? [];
const navLinks = siteConfig.footerNavLinks ?? [];
const currentYear = new Date().getFullYear();
---

<footer class="mx-auto w-full max-w-3xl pt-12 pb-10 sm:pt-24 sm:pb-14">
    <div
        class:list={[
            'border-main flex flex-col gap-4 border-t border-dashed pt-6',
            { 'sm:flex-row-reverse sm:items-center sm:justify-between': socialLinks.length > 0 }
        ]}
    >
        {
            socialLinks.length > 0 && (
                <div class="gap-y- flex flex-wrap gap-x-4">
                    {navLinks.length > 0 &&
                        navLinks.map((link) => (
                            <a class="font-serif hover:underline-offset-2" href={link.href}>
                                {link.text}
                            </a>
                        ))}
                    {socialLinks.map((link) => (
                        <a class="font-serif hover:underline hover:underline-offset-2" href={link.href} target="_blank" rel="noopener noreferer">
                            {link.text}
                        </a>
                    ))}
                </div>
            )
        }
        <p class="text-sm">
            &copy; {currentYear}
            <a class="hover:underline hover:underline-offset-2" href="/">{siteConfig.title}</a>. All rights reserved.
        </p>
    </div>
</footer>
